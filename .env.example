# --- Runtime & MongoDB Atlas ---
NODE_ENV=production
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/janSamasyaDB?retryWrites=true&w=majority
MONGODB_DB_NAME=janSamasyaDB
JWT_SECRET=                          # min 32 random chars, e.g. openssl rand -hex 32

# --- Public URLs ---
APP_URL=https://jansamasyanivaran.netlify.app
NEXT_PUBLIC_APP_URL=https://jansamasyanivaran.netlify.app

# --- Resident auth: password-based ---
RESET_TOKEN_MINUTES=60              # single-use reset link expiry

# --- Telegram admin alerts ---
TELEGRAM_BOT_TOKEN=                  # from @BotFather
TELEGRAM_ADMIN_CHAT_ID=              # admin group/user chat id receiving new-complaint alerts

# --- Email ---
EMAIL_PROVIDER=console
EMAIL_FROM=no-reply@jansamasyanivaran.netlify.app

# --- Storage ---
STORAGE_PROVIDER=local
UPLOAD_DIR=./storage/uploads

# --- First admin configuration ---
ADMIN_EMAIL=riteshsharmajpr123@gmail.com
ADMIN_PASSWORD=8302499289
ADMIN_NAME=Ward Admin

# --- Sessions / security ---
USER_SESSION_DAYS=30
ADMIN_SESSION_HOURS=12

# --- Data ---
SEED_DEMO_DATA=false
